# ============================================================
#  AI VS STREAMER — variáveis de ambiente (copie para .env)
#  Tudo aqui também pode ser configurado pelo PAINEL (http://localhost:8787)
# ============================================================

# ---------- Servidor ----------
PORT=8787
HOST=0.0.0.0

# ---------- Twitch ----------
# Canal que será lido (sem #). Ex: gaules
TWITCH_CHANNEL=
# Para o robô PODER ESCREVER no chat (opcional).
# Gere em https://twitchtokengenerator.com -> "Bot Chat Token" (escopo chat:read chat:edit)
# Formato: oauth:xxxxxxxxxxxxxxxxxxxxx  (o prefixo "oauth:" é opcional)
TWITCH_OAUTH=
# Conta do bot (só usada se TWITCH_OAUTH estiver setado). Ex: meu_bot
TWITCH_USERNAME=

# ---------- YouTube (opcional) ----------
# ID do vídeo/live. Ex: dQw4w9WgXcQ
YOUTUBE_VIDEO_ID=

# ---------- Inteligência Artificial (LLM) ----------
# Opções: auto | openai | groq | openrouter | gemini | anthropic | ollama | lmstudio | custom | none
# "none" = usa o cérebro local (funciona 100% offline, sem chave)
AI_PROVIDER=auto
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
# Temperatura da IA (0 = séria, 1.5 = caótica)
AI_TEMPERATURE=0.95

# Chaves por provedor (o modo "auto" detecta qual está preenchida, nesta ordem)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama / LM Studio local
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Robô ----------
ROBOT_NAME=VEX
STREAMER_NAME=Streamer
GAME_NAME=

# ---------- Rodada ----------
# 600 segundos = 10 minutos por fase (é o padrão do formato original)
PHASE_SECONDS=600
# Janela de votação (acontece nos últimos N segundos de cada fase)
VOTE_WINDOW_SECONDS=60
# Modo inicial: streamer (atrapalha) ou chat (conversa com o chat)
START_MODE=streamer
# Auto-inicia a rodada quando o servidor sobe
AUTO_START=1

# ---------- Demo / Simulador ----------
# SIM=1 liga um chat falso (com votos) para testar sem estar ao vivo
SIM=0
SIM_MESSAGES_PER_MINUTE=14
