# ============================================================================
#  Copie este arquivo para ".env" e preencha as chaves.
#  O .env NAO vai para o Git (ja esta no .gitignore).
#
#  ATENCAO no Windows: o Bloco de Notas costuma salvar como ".env.txt".
#  O robo avisa se achar esse arquivo, mas o certo e o nome ser exatamente ".env"
#  (no Explorer, ative "Exibir > Extensoes de nome de arquivo" para conferir).
#
#  Depois de preencher, rode:  python main.py --check
#  Ele mostra de onde cada chave foi lida (sem revelar o miolo delas).
# ============================================================================

# --- IA: APInex (https://apinex.bond/keys) ----------------------------------
# A key comeca com "sk-apx". Sem ela o robo usa frases prontas (provedor offline).
APINEX_API_KEY=

# --- Twitch (https://twitchtokengenerator.com -> "Bot Chat Token") ----------
# Precisa dos escopos chat:read E chat:edit.
# Sem o token o robo conecta em MODO ANONIMO: ele le o chat, mas NAO responde.
# Pode colar com ou sem o prefixo "oauth:".
TWITCH_OAUTH=

# --- OmniRouter / OmniRoute (gateway local ou na nuvem) ---------------------
# 1) OmniRoute auto-hospedado (http://localhost:20128/v1): rode `omniroute` na
#    sua maquina. Normalmente NAO precisa de key - deixe em branco.
#    O robo usa o modelo oc/deepseek-v4-flash-free (OpenCode Free: gratis).
# 2) omnirouter.li / omnirouter.cc: cole a key do painel abaixo.
# Tambem aceita os nomes OMNI_API_KEY, OMNIROUTE_API_KEY e OMNI_KEY.
# Para usar: mude "provider" no config.json para "omnirouter"
#           (ou digite !provedor omnirouter no chat).
OMNIROUTER_API_KEY=

# --- Outros provedores (opcionais) ------------------------------------------
# Para usar: "!provedor openai" no chat, ou mude "provider" no config.json.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
