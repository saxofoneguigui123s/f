# Copie este arquivo para ".env" e preencha as chaves.
# O .env NAO vai para o Git (ja esta no .gitignore).

# APInex - https://apinex.bond/keys  (provedor padrao do robo)
# A key comeca com "sk-apx"
APINEX_API_KEY=sk-apx_coloque_sua_key_aqui

# Twitch - token de chat (https://twitchtokengenerator.com -> "Bot Chat Token")
# Precisa dos escopos chat:read e chat:edit. Sem token o robo so le o chat.
TWITCH_OAUTH=

# Outros provedores (opicionais - use "!provedor openai" para trocar)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
